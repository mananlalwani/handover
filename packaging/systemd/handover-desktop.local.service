[Unit]
Description=Handover desktop notification and media bridge
After=graphical-session-pre.target handoverd.service
Wants=handoverd.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/handover-desktop
Restart=on-failure
RestartSec=3s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=graphical-session.target
