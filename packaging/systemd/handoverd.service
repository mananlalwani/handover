[Unit]
Description=Handover Android device integration daemon
After=dbus.socket

[Service]
Type=simple
ExecStart=/usr/bin/handoverd
Restart=on-failure
RestartSec=3s
RuntimeDirectory=handover
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
AmbientCapabilities=
ProtectSystem=full
ProtectKernelTunables=yes
# Capability bounding and module protection require user-namespace capabilities
# denied by Ubuntu's default AppArmor policy. This user service stays unprivileged.
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# libc getifaddrs uses route netlink on Linux; native mDNS discovery depends on it.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
