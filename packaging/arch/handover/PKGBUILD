# Maintainer: Handover contributors

pkgname=handover
pkgver=0.3.4
pkgrel=1
pkgdesc='Android and Linux continuity daemon and CLI'
arch=('x86_64' 'aarch64')
url='https://github.com/mananlalwani/handover'
license=('MIT')
depends=('gcc-libs' 'glibc' 'openssl' 'dbus')
makedepends=('rust' 'cargo')
optdepends=(
  'quickshell: example panel'
  'playerctl: pause local MPRIS players during phone calls'
  'python: optional Google Messages setup with an installed Chromium browser'
  'kdeconnect: optional compatibility backend'
  'handover-gmessages: legacy Google Messages compatibility backend (AGPL)'
)
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "$pkgname-$pkgver"
  # The published v0.3.4 source archive predates the native helper crate.
  if [[ -f crates/handover-google-messages/Cargo.toml ]]; then
    cargo build --release --frozen --offline -p handoverd -p handoverctl -p handover-google-messages
  else
    cargo build --release --frozen --offline -p handoverd -p handoverctl
  fi
}

package() {
  cd "$pkgname-$pkgver"
  make PREFIX=/usr DESTDIR="$pkgdir" \
    GOOGLE_MESSAGES_SETUP=1 \
    USER_DATA_HOME=/usr/share \
    USER_UNIT_DIR="$pkgdir/usr/lib/systemd/user" \
    UNIT_SRC=packaging/systemd/handoverd.service \
    install-files
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
