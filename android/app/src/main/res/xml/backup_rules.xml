<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Identity keys are Keystore-backed, while preferences contain peer pins,
         pairing state, and update metadata. None may leave this device. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
